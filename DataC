    navPb.style = "cursor: pointer; color: #00796b; display: block; margin-top: 5px;";
    navPb.onclick = executePBImport;
    navHtml.append(navPb);

    const navDans = document.createElement("a");
    navDans.innerText = "▶️ 단위인정 및 매칭 클래스 가져오기";
    navDans.style = "cursor: pointer; color: #00796b; display: block; margin-top: 5px;";
    navDans.onclick = executeDanAndClassImport;
    navHtml.append(navDans);

    topNode.append(navHtml);
