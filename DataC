    if (!topNode) return;

    const navHtml = document.createElement("div");
    navHtml.style = "margin-top: 10px; padding: 10px; background: #e0f7fa; border-radius: 5px;";
    
    const titleText = document.createElement("b");
    titleText.innerText = "📊 구글 스프레드시트 연동기";
    navHtml.append(titleText);
    navHtml.append(document.createElement("br"));

    const navRecent = document.createElement("a");
    navRecent.innerText = "▶️ 최근 플레이 스코어 가져오기 (추천)";
    navRecent.style = "cursor: pointer; color: #00796b; display: block; margin-top: 5px;";
    navRecent.onclick = async () => {
        const req = await fetchMaimaiNet("/maimai-mobile/record/");
        const docu = (new DOMParser()).parseFromString(await req.text(), "text/html");
